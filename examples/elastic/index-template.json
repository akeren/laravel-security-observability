{
  "index_patterns": [
    "security-observability-*"
  ],
  "priority": 200,
  "_meta": {
    "ecs_version": "9.5.0",
    "mapper_version": "1.0.0"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date_nanos"
        },
        "ecs": {
          "properties": {
            "version": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "created": {
              "type": "date_nanos"
            },
            "kind": {
              "type": "keyword"
            },
            "code": {
              "type": "keyword"
            },
            "action": {
              "type": "keyword"
            },
            "outcome": {
              "type": "keyword"
            },
            "module": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "severity": {
              "type": "long"
            },
            "category": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "duration": {
              "type": "long"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "environment": {
              "type": "keyword"
            }
          }
        },
        "trace": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "span": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "target": {
              "properties": {
                "id": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "related": {
          "properties": {
            "user": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "id": {
                  "type": "keyword"
                },
                "method": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "long"
                }
              }
            }
          }
        },
        "kater": {
          "properties": {
            "mapper": {
              "properties": {
                "version": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "schema": {
              "properties": {
                "version": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "severity": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "correlation": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "request": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "actor": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "target": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "tenant": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "attributes": {
              "type": "object",
              "enabled": false
            }
          }
        }
      }
    }
  }
}
